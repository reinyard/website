---
// Self-hosted architecture: what runs where.
const nodes = [
  { id: 'team', k: 'Your team', t: 'Invite-only sign-in', d: 'People join by invitation. Work is organized in workspaces with roles.' },
  { id: 'front', k: 'Frontend', t: 'A small Go server', d: 'Serves the interface to your team.' },
  { id: 'back', k: 'Backend', t: 'Go', d: 'Pipelines, commits, runs and records. Starts a sandbox for every run.' },
  { id: 'db', k: 'Database', t: 'SQLite or Postgres', d: 'SQLite to start simply; Postgres for a shared, managed database.' },
  { id: 'box', k: 'Execution', t: 'Docker Sandboxes', d: 'One microVM per run, removed afterwards. Only the outputs come back.' },
  { id: 'drive', k: 'Google Drive', t: 'Granted folders only', d: 'Read-only, limited to the folders an agent has been granted.' },
];
---

<section class="section" id="deploy">
  <div class="wrap">
    <div class="head reveal">
      <span class="label">Deployment</span>
      <h2 class="h2">Run it where your data lives.</h2>
      <p class="lead">
        Reinyard is self-hosted: the platform and its database run on infrastructure you control. A managed cloud is coming for teams
        that would rather not run it themselves.
      </p>
    </div>

    <div class="diagram reveal" data-live>
      <ul class="grid">
        <li class="boundary" aria-hidden="true"><span class="mono">Your infrastructure</span></li>
        {
          nodes.map((n) => (
            <li class={`node n-${n.id}`}>
              <span class="k mono">{n.k}</span>
              <b>{n.t}</b>
              <span class="d">{n.d}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <a class="btn" href="/docs/self-hosting/">
      Self-hosting guide
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
    </a>
  </div>
</section>

<script>
  const d = document.querySelector('[data-live]');
  if (d) new IntersectionObserver(([e]) => d.classList.toggle('live', e.isIntersecting)).observe(d);
</script>

<style>
  .head {
    max-width: 44rem;
  }
  .diagram {
    position: relative;
    margin-block: clamp(2.2rem, 5vw, 3.4rem) 2.2rem;
  }
  /* the self-hosting boundary: frontend, backend, database and sandboxes sit inside it; your team and Drive do not */
  .boundary {
    grid-column: 2 / 5;
    grid-row: 1 / 3;
    margin: -1.1rem -1.1rem -0.9rem;
    position: relative;
    border: 1.5px dashed color-mix(in srgb, var(--blue) 50%, var(--line));
    border-radius: 18px;
    pointer-events: none;
    background: color-mix(in srgb, var(--blue) 3%, transparent);
    z-index: 0;
  }
  .boundary span {
    position: absolute;
    top: -0.65rem;
    left: 1.2rem;
    padding: 0 0.6rem;
    background: var(--bg);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue-text);
  }
  .grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    grid-template-areas:
      'team front back box drive'
      '. . db . .';
    gap: 3.4rem 2.2rem;
    padding-block: 0.4rem;
  }
  .n-team { grid-area: team; }
  .n-front { grid-area: front; }
  .n-back { grid-area: back; }
  .n-box { grid-area: box; }
  .n-db { grid-area: db; }
  .n-drive { grid-area: drive; }

  .node {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.35rem;
    padding: 1.1rem 1.15rem 1.2rem;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    transition: border-color 0.25s, transform 0.35s var(--ease), box-shadow 0.3s;
    z-index: 1;
  }
  .node:hover {
    border-color: color-mix(in srgb, var(--blue) 55%, var(--line));
    transform: translateY(-3px);
    box-shadow: 0 18px 36px -24px color-mix(in srgb, var(--ink) 45%, transparent);
  }
  .k {
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  b {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .d {
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.45;
  }
  /* animated links between nodes */
  .node::after {
    content: '';
    position: absolute;
    background-image: repeating-linear-gradient(90deg, var(--blue) 0 6px, transparent 6px 14px);
    background-size: 14px 2px;
  }
  .n-team::after,
  .n-front::after,
  .n-back::after,
  .n-box::after {
    left: 100%;
    top: 2.2rem;
    width: 2.2rem;
    height: 2px;
  }
  .n-db::after,
  .n-drive::after {
    display: none;
  }
  .n-back::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 100%;
    width: 2px;
    height: 3.2rem;
    background-image: repeating-linear-gradient(180deg, var(--blue) 0 6px, transparent 6px 14px);
  }
  /* the dashes only move while the diagram is on screen (set by the script below): off-screen animation costs main-thread time */
  .live .node::after {
    animation: flow 1.2s linear infinite;
  }
  .live .n-back::before {
    animation: flowv 1.2s linear infinite;
  }
  @keyframes flow {
    to {
      background-position: 14px 0;
    }
  }
  @keyframes flowv {
    to {
      background-position: 0 14px;
    }
  }
  @media (max-width: 1000px) {
    .boundary {
      display: none;
    }
    .grid {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        'team front'
        'back box'
        'db drive';
      gap: 1rem;
    }
    .node::after,
    .node::before {
      display: none !important;
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
      grid-template-areas: 'team' 'front' 'back' 'db' 'box' 'drive';
    }
  }
</style>
