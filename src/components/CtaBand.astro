---
import Mark from './Mark.astro';
---

<section class="cta">
  <div class="wrap inner">
    <h2>Put your agents<br />on a rein.</h2>
    <div class="row">
      <a class="btn primary" href="/docs/">
        Read the docs
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
      </a>
      <a class="btn" href="mailto:contact@reinyard.com">Contact us</a>
    </div>
    <div class="big" aria-hidden="true"><Mark size={360} tile={false} /></div>
  </div>
</section>

<style>
  .cta {
    --ring: #dbe8f4;
    --core: #97ccf7;
    background: var(--deep);
    color: var(--on-deep);
    overflow: clip;
  }
  .inner {
    position: relative;
    padding-block: clamp(4.5rem, 10vw, 8rem);
    display: grid;
    gap: 2.2rem;
    justify-items: start;
  }
  h2 {
    font-size: clamp(2.1rem, 5.6vw, 4.2rem);
    letter-spacing: -0.045em;
    line-height: 1.04;
    position: relative;
    z-index: 1;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    position: relative;
    z-index: 1;
  }
  .cta :global(.btn.primary) {
    background: #ffffff;
    border-color: #ffffff;
    color: var(--deep);
  }
  .cta :global(.btn:not(.primary)) {
    background: transparent;
    color: var(--on-deep);
    border-color: rgba(255, 255, 255, 0.5);
  }
  .cta :global(.btn:not(.primary):hover) {
    background: rgba(255, 255, 255, 0.12);
  }
  .big {
    position: absolute;
    right: -2rem;
    top: 50%;
    translate: 0 -50%;
    opacity: 0.2;
  }
  @media (max-width: 760px) {
    .big {
      opacity: 0.1;
      right: -6rem;
    }
  }
</style>
