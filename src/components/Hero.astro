---
import GithubIcon from './GithubIcon.astro';
// The hero is a living yard: named agents run work in a hexagon field. A tracking line reaches each run, the
// sandbox's brackets close, badges change, and agents are created, edited (new commit) and deleted.
// See src/scripts/hero/tracked.ts.
---

<section class="hero">
  <div class="stage">
    <canvas data-scene="tracked" aria-hidden="true"></canvas>

    <div class="wrap copy">
      <h1>
        <span>Agents</span>
        <span>on a</span>
        <span class="rein brk">rein.</span>
      </h1>
      <p class="sub">
        Build, version and run agents and automations in isolated sandboxes. Every change lives in Git. Every run is on
        record.
      </p>

      <div class="cta">
        <a class="btn primary" href="/docs/">
          Read the docs
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
        </a>
        <a class="btn" href="https://github.com/reinyard" rel="noopener">
          <GithubIcon size={17} />
          GitHub
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // The hero scene is decoration: load it after the page has painted and loaded, so it never competes with
  // the text, the CSS or the fonts. The canvas fades in once the scene is running.
  import { start } from '../scripts/hero/index.ts';
  if (document.readyState === 'complete') start();
  else addEventListener('load', () => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 1200 }) : setTimeout(start, 150)), { once: true });
</script>

<style>
  .hero {
    position: relative;
    /* starts at the top edge, under the floating header; the strip below takes about 5rem of the first screen */
    min-height: min(100svh - 5rem, 62rem);
    display: flex;
    flex-direction: column;
  }
  .stage {
    position: relative;
    isolation: isolate;
    flex: 1;
    display: grid;
    align-items: center;
    padding-block: calc(4.25rem + clamp(3rem, 7vw, 6rem)) clamp(2rem, 4vw, 3rem);
    overflow: clip;
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    opacity: 0;
    transition: opacity 0.9s var(--ease);
  }
  canvas.on {
    opacity: 1;
  }
  .copy {
    display: grid;
    justify-items: start;
    /* the hero is a live scene: dragging over it should never highlight the headline */
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }
  h1 {
    display: grid;
    justify-items: start;
    font-size: clamp(2.6rem, 8vw, 6.6rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
    font-weight: 600;
  }
  /* The headline is the largest contentful paint, so it must be visible from the first frame: it slides, it does not fade. */
  h1 > span {
    display: block;
    animation: slide 0.7s var(--ease) both;
  }
  h1 > span:nth-child(2) {
    animation-delay: 0.05s;
  }
  h1 > span:nth-child(3) {
    animation-delay: 0.1s;
  }
  @keyframes slide {
    from {
      transform: translateY(14px);
    }
  }
  .rein {
    --bl: 0.22em;
    --bw: 0.05em;
    --bc: var(--blue);
    color: var(--blue);
    margin-top: 0.06em;
    padding: 0.04em 0.2em 0.1em 0.16em;
    margin-left: -0.16em;
  }
  .rein::before {
    animation: lock 1.1s 0.5s var(--ease) both;
  }
  @keyframes lock {
    from {
      inset: -0.35em;
      opacity: 0;
    }
    to {
      inset: 0;
      opacity: 1;
    }
  }
  .sub {
    margin-top: 1.8rem;
    max-width: 33rem;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.7vw, 1.28rem);
    animation: slide 0.7s 0.12s var(--ease) both;
  }
  /* light theme only: a touch stronger than --muted, because this text sits on the moving hexagon field and its worst case is a pattern line */
  :global(:root[data-theme='light']) .sub {
    color: color-mix(in srgb, var(--muted) 78%, var(--ink));
  }
  .cta {
    margin-top: 2.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    animation: rise 1s 0.32s var(--ease) both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }

  @media (max-width: 899px) {
    .stage {
      min-height: 46rem;
      align-items: start;
    }
  }
</style>
