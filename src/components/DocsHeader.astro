---
// Replaces Starlight's header so the docs share the site's wordmark, links, theme switch and login badge.
import Search from '@astrojs/starlight/components/Search.astro';
import Wordmark from './Wordmark.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import GithubIcon from './GithubIcon.astro';
const links = [
  { href: '/docs/', label: 'Docs' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/about/', label: 'About' },
];
---

<div class="dh">
  <Wordmark size={34} />
  <nav class="links" aria-label="Site">
    {links.map((l) => <a href={l.href} aria-current={l.href === '/docs/' ? 'page' : undefined}>{l.label}</a>)}
  </nav>
  <div class="search"><Search /></div>
  <div class="right">
    <ThemeSwitch />
    <a class="gh" href="https://github.com/reinyard" rel="noopener" aria-label="Reinyard on GitHub" title="GitHub"><GithubIcon /></a>
    <button class="login" type="button" disabled aria-disabled="true" title="The managed cloud is coming soon">
      <span>Log in</span><em>Soon</em>
    </button>
  </div>
</div>

<style>
  .dh {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 100%;
    width: 100%;
  }
  .links,
  .right {
    display: none;
  }
  .search {
    flex: 1;
    min-width: 0;
    display: flex;
    justify-content: flex-end;
  }
  .links a {
    padding: 0.5rem 0.8rem;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s;
  }
  .links a {
    border-radius: 999px;
  }
  .links a:hover,
  .links a[aria-current] {
    color: var(--ink);
  }
  .links a[aria-current] {
    background: var(--bg-3);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .gh {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--r);
    color: var(--muted);
    transition: color 0.2s, background 0.2s;
  }
  .gh:hover {
    color: var(--ink);
    background: var(--bg-3);
  }
  .login {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    height: 2.5rem;
    padding: 0 0.5rem 0 1rem;
    border-radius: var(--r);
    border: 1px dashed var(--line);
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: not-allowed;
  }
  .login em {
    font-style: normal;
    font-family: var(--mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue-text);
    background: var(--a-1);
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
  }
  @media (min-width: 50rem) {
    .links {
      display: flex;
    }
    .search {
      flex: 0 1 17rem;
      margin-left: auto;
    }
    .right {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
  }
</style>
