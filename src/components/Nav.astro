---
// a compact pill that floats above the page and blurs what scrolls under it.
import Mark from './Mark.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import GithubIcon from './GithubIcon.astro';
const links = [
  { href: '/docs/', label: 'Docs' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/about/', label: 'About' },
];
---

<div class="nav">
  <a class="skip" href="#main">Skip to content</a>
  <header class="pill">
    <a class="brand" href="/" aria-label="reinyard home"><Mark size={28} /><span>reinyard.</span></a>
    <nav class="links" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="actions">
      <a class="gh" href="https://github.com/reinyard" rel="noopener" aria-label="Reinyard on GitHub" title="GitHub"><GithubIcon size={19} /></a>
      <ThemeSwitch />
      <button class="login" type="button" disabled aria-disabled="true" title="The managed cloud is coming soon"><span>Log in</span><em>Soon</em></button>
      <details class="menu">
        <summary aria-label="Menu"><span></span><span></span></summary>
        <div class="sheet">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
          <a class="gh-row" href="https://github.com/reinyard" rel="noopener"><GithubIcon size={18} />GitHub</a>
          <div class="login-m" aria-disabled="true">Log in / Sign up <em>Coming soon</em></div>
        </div>
      </details>
    </div>
  </header>
</div>

<script>
  // The mobile menu is a <details>: close it after choosing a link (same-page anchors do not reload) and on Escape.
  const menu = document.querySelector<HTMLDetailsElement>('.nav .menu');
  if (menu) {
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.sheet a')) menu.open = false;
    });
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  /* floats over the page, so the hero's hexagon field runs right up to the top edge */
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: 0.75rem var(--gutter);
    pointer-events: none;
  }
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    background: var(--accent);
    color: var(--on-accent);
    padding: 0.5rem 0.9rem;
    border-radius: var(--r);
    z-index: 100;
  }
  .skip:focus {
    top: 0.75rem;
  }
  .nav > * {
    pointer-events: auto;
  }
  .pill {
    position: relative;
    max-width: 62rem;
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 0.45rem 0.55rem 0.45rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-2) 78%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: 0 16px 40px -24px color-mix(in srgb, var(--ink) 55%, transparent);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .links {
    display: flex;
    margin-left: 0.8rem;
  }
  .links a {
    padding: 0.45rem 0.85rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--muted);
    border-radius: 999px;
    transition:
      color 0.2s,
      background 0.2s;
  }
  .links a:hover {
    color: var(--ink);
    background: var(--bg-3);
  }
  .actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .gh {
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    color: var(--muted);
  }
  .gh:hover {
    color: var(--ink);
    background: var(--bg-3);
  }
  .login,
  .login-m {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    height: 2.3rem;
    padding: 0 0.4rem 0 0.95rem;
    border-radius: 999px;
    border: 1px dashed var(--line);
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 500;
    cursor: not-allowed;
  }
  em {
    font-style: normal;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue-text);
    background: var(--blue-soft);
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
  }
  .menu {
    display: none;
  }
  .menu summary {
    list-style: none;
    display: grid;
    place-content: center;
    gap: 5px;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--bg-2);
    cursor: pointer;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu summary span {
    width: 14px;
    height: 2px;
    background: var(--ink);
  }
  .sheet {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 0.5rem);
    padding: 0.4rem 1.2rem 1rem;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--bg-2);
    display: grid;
    z-index: 5;
  }
  .sheet a,
  .sheet .login-m {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }
  .sheet .gh-row {
    display: flex;
    gap: 0.7rem;
    align-items: center;
  }
  .sheet .login-m {
    border: 0;
    height: auto;
    border-radius: 0;
    justify-content: space-between;
    padding-right: 0;
  }
  @media (max-width: 860px) {
    .links,
    .actions > .gh,
    .login {
      display: none;
    }
    .menu {
      display: block;
    }
  }
</style>
