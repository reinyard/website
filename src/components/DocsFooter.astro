---
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default><slot /></Default>
<div class="site-foot">
  <span>© 2026 Reinyard</span>
  <nav aria-label="Footer">
    <a href="/">Home</a>
    <a href="/docs/security/">Security</a>
    <a href="/licenses/">Licenses</a>
    <a href="https://github.com/reinyard" rel="noopener">GitHub</a>
    <a href="mailto:contact@reinyard.com">Contact</a>
  </nav>
</div>

<style>
  .site-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
  }
  a {
    color: var(--muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--blue-text);
  }
</style>
