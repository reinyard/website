---
// three plans as headers over one comparison table. There are no prices, so the table does the work.
// Enterprise is the same platform, as SaaS, on-premises or hybrid, plus the controls larger organizations require.
const rows = [
  { f: 'Pipelines versioned in Git', s: true, m: true, e: true },
  { f: 'Isolated sandbox execution', s: true, m: true, e: true },
  { f: 'Run records and scoped access', s: true, m: true, e: true },
  { f: 'Workspaces, roles and invite-only sign-in', s: true, m: true, e: true },
  { f: 'Runs on infrastructure you control', s: true, m: false, e: true },
  { f: 'SQLite or Postgres', s: true, m: false, e: true },
  { f: 'No servers to run', s: false, m: true, e: true },
  { f: 'Updates handled for you', s: false, m: true, e: true },
  { f: 'Single sign-on (SSO)', s: false, m: false, e: true, ent: true },
  { f: 'SCIM provisioning', s: false, m: false, e: true, ent: true },
  { f: 'Audit logs', s: false, m: false, e: true, ent: true },
  { f: 'SIEM integration', s: false, m: false, e: true, ent: true },
  { f: 'Delegated admin roles', s: false, m: false, e: true, ent: true },
  { f: 'Metrics and alerting', s: false, m: false, e: true, ent: true },
  { f: 'Support with an SLA', s: false, m: false, e: true, ent: true },
];
---

<section id="pricing" class="pricing" data-live>
  <div class="wrap">
    <header class="head">
      <span class="label">Pricing</span>
      <h2 class="h2">Your infrastructure, our cloud, or both.</h2>
      <p class="lead">Run Reinyard on-premises, as a managed SaaS, or as a hybrid of both. The first release is self-hosted, the managed cloud is coming soon, and installation steps arrive with the release.</p>
    </header>

    <div class="plans">
      <div class="corner mono" aria-hidden="true"><span>Included</span></div>
      <article class="plan on">
        <div class="r"><h3>Self-hosted</h3><span class="badge">First release</span></div>
        <p class="price">Your infrastructure</p>
        <p class="d">The full platform, running on servers you control.</p>
        <a class="btn primary" href="/docs/self-hosting/">
          Self-hosting guide
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
        </a>
      </article>
      <article class="plan soon">
        <div class="r"><h3>Managed cloud</h3><span class="badge">Coming soon</span></div>
        <p class="price">Pricing at launch</p>
        <p class="d">The same platform, operated by us.</p>
        <a class="btn" href="mailto:contact@reinyard.com?subject=Managed%20cloud">
          Get notified
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
        </a>
      </article>
      <article class="plan ent">
        <div class="r"><h3>Enterprise</h3><span class="badge">Contact us</span></div>
        <p class="price">Custom</p>
        <p class="d">Everything above, as SaaS, on-premises or hybrid, with the controls larger organizations require.</p>
        <a class="btn" href="mailto:contact@reinyard.com?subject=Enterprise">
          Talk to us
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
        </a>
      </article>
    </div>

    <table class="cmp">
      <caption class="sr-only">What each option includes</caption>
      <thead><tr><th scope="col"><span class="sr-only">Feature</span></th><th scope="col"><span class="sr-only">Self-hosted</span><span aria-hidden="true">Self</span></th><th scope="col"><span class="sr-only">Managed cloud</span><span aria-hidden="true">Cloud</span></th><th scope="col"><span class="sr-only">Enterprise</span><span aria-hidden="true">Ent.</span></th></tr></thead>
      <tbody>
        {
          rows.map((r, i) => (
            <tr style={`--i:${i}`} class:list={{ ent: r.ent }}>
              <th scope="row">{r.f}</th>
              <td class:list={{ y: r.s }}>{r.s ? <><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" /></svg><span class="sr-only">Included</span></> : <><i aria-hidden="true"></i><span class="sr-only">Not applicable</span></>}</td>
              <td class:list={{ y: r.m }}>{r.m ? <><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" /></svg><span class="sr-only">Included at launch</span></> : <><i aria-hidden="true"></i><span class="sr-only">Not applicable</span></>}</td>
              <td class:list={{ y: r.e }}>{r.e ? <><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" /></svg><span class="sr-only">Included</span></> : <><i aria-hidden="true"></i><span class="sr-only">Not applicable</span></>}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="note">Questions about your setup? <a href="mailto:contact@reinyard.com">contact@reinyard.com</a></p>
  </div>
</section>

<style>
  .pricing {
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .head {
    display: grid;
    gap: 0.9rem;
    max-width: 44rem;
  }
  .plans,
  .cmp tr {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) repeat(3, minmax(0, 1fr));
  }
  .plans {
    margin-top: clamp(2rem, 5vw, 3.4rem);
    gap: 1rem;
  }
  .corner {
    align-self: end;
    padding: 0 1.5rem 1.2rem;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .plan {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem 1.5rem 1.6rem;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--r-lg) var(--r-lg) 0 0;
    border-bottom: 0;
    position: relative;
  }
  .plan.on {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }
  .plan.soon {
    border-style: dashed;
  }
  .plan.ent {
    background: var(--deep);
    border-color: var(--deep);
    color: var(--on-deep);
  }
  .plan.ent .d {
    color: var(--on-deep-muted);
  }
  .plan.ent .badge {
    color: var(--on-deep);
    border-color: var(--deep-line);
    background: transparent;
  }
  .plan.ent .btn {
    background: #fff;
    border-color: #fff;
    color: var(--deep);
  }
  .cmp tr.ent th {
    color: var(--ink);
    font-weight: 600;
  }
  .r {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 0.8rem;
  }
  .r .badge {
    white-space: nowrap;
  }
  h3 {
    font-size: 1.1rem;
  }
  .price {
    margin-top: 0.8rem;
    font-size: clamp(1.4rem, 2.4vw, 1.8rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .d {
    color: var(--muted);
    font-size: 0.95rem;
    flex: 1;
  }
  .plan .btn {
    white-space: nowrap;
    margin-top: 1rem;
    justify-self: start;
    align-self: start;
  }

  .cmp {
    width: 100%;
    display: block;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-top: 1px solid var(--line);
    border-radius: 0 0 var(--r-lg) var(--r-lg);
  }
  .cmp tbody,
  .cmp thead {
    display: block;
  }
  /* the plan cards name the columns on desktop; on phones this short header does */
  .cmp thead {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .cmp tr {
    gap: 1rem;
    align-items: center;
    padding-inline: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .cmp tr:first-child {
    border-top: 0;
  }
  .cmp th {
    text-align: left;
    font-weight: 500;
    font-size: 0.98rem;
    color: var(--ink-2);
    padding-block: 0.95rem;
  }
  .cmp td {
    display: flex;
    align-items: center;
    min-height: 1.6rem;
    padding-left: 1.5rem;
  }
  .cmp svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: var(--blue);
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cmp td i {
    width: 0.7rem;
    height: 2px;
    background: var(--line);
  }
  .cmp tr {
    transition: background 0.2s;
  }
  .cmp tr:hover {
    background: var(--a-1);
  }
  .pricing.is-live .cmp svg path {
    stroke-dasharray: 16;
    animation: pricing-draw 0.5s calc(var(--i, 0) * 0.06s + 0.2s) var(--ease) both;
  }
  @keyframes pricing-draw {
    from {
      stroke-dashoffset: 16;
    }
  }
  .note {
    margin-top: 1.4rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  /* tablets and small laptops: the cards sit side by side above a compact table (the four-column grid is too tight below about 1140px) */
  @media (max-width: 1140px) {
    .plans {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.8rem;
    }
    .corner {
      display: none;
    }
    .plan {
      border-radius: var(--r-lg);
      border-bottom: 1px solid var(--line);
    }
    .plan.on {
      border-bottom-color: var(--accent);
    }
    .cmp {
      margin-top: 0.8rem;
      border-radius: var(--r-lg);
    }
    .cmp tr {
      grid-template-columns: minmax(0, 1fr) repeat(3, 2.2rem);
      gap: 0.4rem;
      padding-inline: 1rem;
    }
    .cmp th {
      font-size: 0.92rem;
    }
    .cmp td {
      justify-content: center;
      padding-left: 0;
    }
    .cmp thead {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
    }
    .cmp thead tr {
      border-top: 0;
      padding-top: 0.8rem;
    }
    .cmp thead th {
      padding-block: 0;
      text-align: center;
      font-family: var(--mono);
      font-size: 0.64rem;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .cmp tbody tr:first-child {
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 860px) {
    .plans {
      grid-template-columns: 1fr;
    }
  }
  /* where a card is narrow, every plan puts its badge under the name so the three headers line up */
  @media (min-width: 1141px), (min-width: 861px) and (max-width: 980px) {
    .r {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
