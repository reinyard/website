---
// the footer as the page's table of contents. Large numbered rows, hairlines between, and a plain line
// about where the product stands. Reads like the end of a document, not a link dump.
import Wordmark from './Wordmark.astro';
const items = [
  { n: '01', t: 'Pricing', href: '/#pricing' },
  { n: '02', t: 'Documentation', href: '/docs/' },
  { n: '03', t: 'Security model', href: '/docs/security/' },
  { n: '04', t: 'About', href: '/about/' },
  { n: '05', t: 'GitHub', href: 'https://github.com/reinyard', ext: true },
  { n: '06', t: 'Contact', href: 'mailto:contact@reinyard.com' },
  { n: '07', t: 'Licenses', href: '/licenses/' },
];
---

<footer class="footer">
  <div class="wrap main">
    <div class="who">
      <Wordmark />
      <p class="line">A controlled place for agents to work.</p>
      <p class="state mono"><i></i>Self-hosted first · managed cloud coming soon</p>
    </div>
    <ol>
      {
        items.map((x) => (
          <li>
            <a href={x.href} rel={x.ext ? 'noopener' : undefined}>
              <span class="n mono">{x.n}</span>
              <span class="t">{x.t}</span>
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12L12 4M6 4h6v6" /></svg>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
  <div class="wrap legal">
    <span>© 2026 Reinyard</span>
    <a href="mailto:security@reinyard.com">Report a vulnerability</a>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg);
    padding-top: clamp(3rem, 7vw, 5rem);
  }
  .main {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .who {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .line {
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    letter-spacing: -0.035em;
    line-height: 1.12;
    max-width: 16rem;
  }
  .state {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .state i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--blue);
  }
  ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(1.4rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }
  li {
    border-bottom: 1px solid var(--line);
  }
  ol a {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.95rem 0;
    transition: padding 0.3s var(--ease), color 0.2s;
  }
  .n {
    font-size: 0.7rem;
    color: var(--muted);
  }
  .t {
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  ol svg {
    width: 0.95rem;
    height: 0.95rem;
    color: var(--muted);
    opacity: 0;
    transition: opacity 0.2s, translate 0.3s var(--ease);
  }
  ol a:hover,
  ol a:focus-visible {
    padding-left: 0.5rem;
    color: var(--blue-text);
  }
  ol a:hover .t,
  ol a:focus-visible .t {
    color: var(--blue-text);
  }
  ol a:hover .n {
    color: var(--blue-text);
  }
  ol a:hover svg,
  ol a:focus-visible svg {
    opacity: 1;
    color: var(--blue-text);
    translate: 2px -2px;
  }
  .legal {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: clamp(2.4rem, 5vw, 3.6rem);
    padding-block: 1.3rem;
    font-size: 0.84rem;
    color: var(--muted);
  }
  .legal a:hover {
    color: var(--blue-text);
  }
  @media (max-width: 860px) {
    .main {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    ol {
      grid-template-columns: 1fr;
    }
  }
</style>
