---
// six numbered plates on one ruled sheet, each with a small drawing of the capability.
const plates = [
  { t: 'Versioned like code', d: 'Each agent’s pipeline lives in Git, with commits, branches and merges. Every change has an author and a history.' },
  { t: 'Isolated runs', d: 'Pipelines run in isolated sandboxes: Docker Sandboxes (microVMs) on-premises, Google sandboxes in the cloud.' },
  { t: 'Every run on record', d: 'Logs, exit codes and generated files are kept and tied to the exact version that produced them.' },
  { t: 'Scoped access', d: 'An agent can read only the folders it has been granted, and nothing else.' },
  { t: 'Teams stay in control', d: 'Invite-only sign-in, workspaces with roles, and administrators who can see and manage every workspace.' },
  { t: 'Problems are visible', d: 'An overview shows execution health and what needs attention next, drawn from your real run history.' },
];
const cells = Array.from({ length: 24 }, (_, i) => (i === 14 ? 'bad' : i % 7 === 3 ? 'dim' : 'ok'));
---

<section id="product" class="product" data-live>
  <div class="wrap">
    <div class="head">
      <span class="label">Product</span>
      <h2 class="h2">Everything an agent needs. Only what it was granted.</h2>
    </div>

    <div class="sheet brk">
      <div class="plates">
        {
          plates.map((p, i) => (
            <article class={`plate pl${i}`}>
              <header><span class="hex mono">{i + 1}</span><h3>{p.t}</h3></header>
              <div class="draw" aria-hidden="true">
                {i === 0 && (
                  <svg viewBox="0 0 260 110" fill="none">
                    <path class="lane" d="M16 78H244" /><path class="lane br" d="M62 78C82 78 82 34 102 34H168C188 34 188 78 208 78" />
                    <g class="nd"><circle cx="16" cy="78" r="6" /><circle cx="62" cy="78" r="6" /><circle cx="102" cy="34" r="6" /><circle cx="135" cy="34" r="6" class="hot" /><circle cx="168" cy="34" r="6" /><circle cx="208" cy="78" r="6" class="hot" /><circle cx="244" cy="78" r="6" /></g>
                    <text x="16" y="100" class="t">main</text><text x="102" y="20" class="t">branch</text><text x="196" y="100" class="t">merge</text>
                  </svg>
                )}
                {i === 1 && (
                  <svg viewBox="176 128 672 768" fill="none" class="sb">
                    <g class="rg" stroke-width="58" stroke-linecap="round" stroke-linejoin="round"><path d="M297 298 221 342V430" /><path d="M727 298 803 342V430" /><path d="M221 594V682L297 726" /><path d="M803 594V682L727 726" /><path d="M435 220 512 176 589 220" /><path d="M435 804 512 848 589 804" /></g>
                    <path class="co" d="M512 400.1 608.9 456.1V568L512 623.9 415.1 568V456.1Z" stroke-width="28" stroke-linejoin="round" />
                  </svg>
                )}
                {i === 2 && (
                  <ul class="log mono"><li><b>✓</b>pipeline resolved</li><li><b>✓</b>sandbox started</li><li><b>✓</b>files returned</li><li class="x"><b>◆</b>run recorded · exit 0</li></ul>
                )}
                {i === 3 && (
                  <ul class="tree mono"><li class="off"><i></i>Company</li><li class="on"><i></i>Finance<em>read-only</em></li><li class="off sub"><i></i>Payroll</li><li class="off"><i></i>Legal</li></ul>
                )}
                {i === 4 && (
                  <div class="tiles"><span class="tl t1">Demo workspace</span><span class="tl t2">Finance team</span><span class="tl t3">Operations</span><span class="over mono">Administrators see all</span></div>
                )}
                {i === 5 && <div class="cells">{cells.map((c) => <i class={c}></i>)}</div>}
              </div>
              <p>{p.d}</p>
            </article>
          ))
        }
      </div>
      <footer class="strip mono"><span>Reinyard</span><span>Product sheet</span></footer>
    </div>
  </div>
</section>

<style>
  .product {
    padding-block: clamp(4rem, 9vw, 7.5rem);
  }
  .head {
    max-width: 44rem;
  }
  .sheet {
    --bl: 26px;
    --bc: var(--blue);
    --bw: 2px;
    margin-top: clamp(2.2rem, 5vw, 3.4rem);
    padding: 14px;
  }
  .plates {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .plate {
    background: var(--bg);
    padding: 1.4rem 1.4rem 1.6rem;
    display: grid;
    grid-template-rows: auto 9.5rem auto;
    gap: 1.1rem;
    transition: background 0.3s;
  }
  .plate:hover {
    background: var(--bg-2);
  }
  header {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .hex {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 2.15rem;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.78rem;
    font-weight: 600;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
  }
  h3 {
    font-size: 1.2rem;
    letter-spacing: -0.03em;
  }
  .draw {
    display: grid;
    align-items: center;
    justify-items: center;
    border: 1px dashed var(--line);
    border-radius: 6px;
    padding: 0.6rem;
    overflow: hidden;
    background-image: radial-gradient(color-mix(in srgb, var(--ink) 9%, transparent) 1px, transparent 1px);
    background-size: 12px 12px;
  }
  p {
    color: var(--muted);
    font-size: 0.96rem;
  }
  /* 1 */
  .draw svg {
    width: 100%;
    max-height: 100%;
  }
  .lane {
    stroke: var(--line);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .lane.br {
    stroke: var(--ring);
    stroke-dasharray: 260;
    stroke-dashoffset: 260;
    animation: product-draw 3.6s var(--ease) infinite;
    animation-play-state: paused;
  }
  .product.is-live .lane.br {
    animation-play-state: running;
  }
  @keyframes product-draw {
    0% {
      stroke-dashoffset: 260;
    }
    40%,
    85% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 0.2;
    }
  }
  .nd circle {
    fill: var(--bg);
    stroke: var(--ring);
    stroke-width: 3;
  }
  .nd .hot {
    fill: var(--blue);
    stroke: var(--blue);
  }
  .t {
    font-family: var(--mono);
    font-size: 9px;
    fill: var(--muted);
    letter-spacing: 0.06em;
  }
  /* 2 */
  .draw .sb {
    width: 6.2rem;
    max-height: 100%;
    overflow: visible;
  }
  .rg {
    stroke: var(--muted);
    transform-origin: 512px 512px;
    animation: product-close 3.4s var(--ease) infinite;
    animation-play-state: paused;
  }
  .product.is-live .rg {
    animation-play-state: running;
  }
  .co {
    fill: var(--core);
    stroke: var(--core);
  }
  @keyframes product-close {
    0%,
    10% {
      transform: scale(1.4);
      opacity: 0.3;
    }
    30%,
    76% {
      transform: scale(1);
      opacity: 1;
    }
    92%,
    100% {
      transform: scale(1.4);
      opacity: 0.3;
    }
  }
  /* 3 */
  .log {
    justify-self: start;
    display: grid;
    gap: 0.5rem;
    font-size: 0.74rem;
    color: var(--ink-2);
  }
  .log li {
    opacity: 0;
    animation: product-in 6s steps(1) infinite;
    animation-play-state: paused;
  }
  .product.is-live .log li {
    animation-play-state: running;
  }
  .log li:nth-child(2) {
    animation-delay: 0.5s;
  }
  .log li:nth-child(3) {
    animation-delay: 1s;
  }
  .log li:nth-child(4) {
    animation-delay: 1.5s;
    color: var(--ink);
  }
  .log b {
    color: var(--blue-text);
    margin-right: 0.55rem;
    font-weight: 500;
  }
  @keyframes product-in {
    0% {
      opacity: 0;
    }
    6%,
    90% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  /* 4 */
  .tree {
    justify-self: stretch;
    display: grid;
    gap: 0.3rem;
    font-size: 0.76rem;
  }
  .tree li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.5rem;
    border-radius: 6px;
    color: var(--muted);
    border: 1px solid transparent;
  }
  .tree .sub {
    margin-left: 1rem;
  }
  .tree i {
    width: 0.8rem;
    height: 0.58rem;
    border: 1.5px solid currentColor;
    border-radius: 2px;
  }
  .tree .on {
    color: var(--ink);
    background: var(--a-1);
    border-color: var(--a-3);
    font-weight: 600;
  }
  .tree .on i {
    background: var(--blue);
    border-color: var(--blue);
  }
  .tree em {
    margin-left: auto;
    font-style: normal;
    color: var(--blue-text);
    font-size: 0.9em;
  }
  /* 5 */
  .tiles {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .tl {
    position: absolute;
    left: 0;
    right: 0;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--bg-2);
    font-size: 0.74rem;
    transition: transform 0.5s var(--ease);
  }
  .t1 {
    top: 0.1rem;
    left: 0.2rem;
    right: 28%;
  }
  .t2 {
    top: 2.2rem;
    left: 14%;
    right: 14%;
  }
  .t3 {
    top: 4.3rem;
    left: 28%;
    right: 0.2rem;
  }
  .plate:hover .t1 {
    transform: translateX(-4px);
  }
  .plate:hover .t3 {
    transform: translateX(4px);
  }
  .over {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.25rem 0.5rem;
    border-top: 1px dashed var(--blue);
    color: var(--blue-text);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
  }
  /* 6 */
  .cells {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem;
  }
  .cells i {
    width: 1.5rem;
    height: 1.7rem;
    background: var(--blue);
    opacity: 0.78;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
  }
  .cells .dim {
    opacity: 0.38;
  }
  .cells .bad {
    background: var(--red);
    opacity: 1;
  }
  .strip {
    margin-top: 0.8rem;
    display: flex;
    justify-content: space-between;
    padding-inline: 0.2rem;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 980px) {
    .plates {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .plates {
      grid-template-columns: 1fr;
    }
  }
</style>
