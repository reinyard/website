---
const qa = [
  { q: 'Which version ran?', a: 'A commit.', d: 'Pipelines live in Git. Commits never change, and every run names the exact one that produced it.', icon: 'commit' },
  { q: 'What could it touch?', a: 'Only what it was granted.', d: 'Access is per agent and per folder, read-only. Nothing outside the granted folders is in range.', icon: 'scope' },
  { q: 'What happened?', a: 'A record of every run.', d: 'Logs, exit code and generated files are kept and tied to the version that ran.', icon: 'record' },
];
---

<section class="statement">
  <div class="wrap">
    <p class="big reveal">
      Agents are easy to build.
      <span>Knowing what they did is the hard part.</span>
    </p>

    <ul class="qa">
      {
        qa.map((x) => (
          <li class="reveal">
            <svg class={`ico ${x.icon}`} viewBox="0 0 48 48" fill="none" aria-hidden="true">
              {x.icon === 'commit' && (
                <>
                  <path d="M8 34h32" class="rail" />
                  <path d="M16 34c4 0 4-14 9-14h6c5 0 5 14 9 14" class="rail b" />
                  <circle cx="8" cy="34" r="3.2" /><circle cx="16" cy="34" r="3.2" /><circle cx="25" cy="20" r="3.2" class="hot" /><circle cx="40" cy="34" r="3.2" class="hot" />
                </>
              )}
              {x.icon === 'scope' && (
                <>
                  <path d="M6 14a3 3 0 0 1 3-3h9l4 4h17a3 3 0 0 1 3 3v17a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3Z" class="rail b" />
                  <path d="M24 21.5 29 24.4v5.2L24 32.5l-5-2.9v-5.2Z" class="hot fill" />
                </>
              )}
              {x.icon === 'record' && (
                <>
                  <rect x="9" y="9" width="30" height="30" rx="5" class="rail b" />
                  <path d="M16 19h16M16 25h16M16 31h9" class="rail" />
                  <circle cx="34" cy="31" r="3.2" class="hot fill" />
                </>
              )}
            </svg>
            <p class="q mono">{x.q}</p>
            <h3>{x.a}</h3>
            <p class="d">{x.d}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .statement {
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }
  .big {
    max-width: 52rem;
    font-size: clamp(1.7rem, 4vw, 3.1rem);
    line-height: 1.12;
    letter-spacing: -0.04em;
    font-weight: 600;
  }
  .big span {
    display: block;
    margin-top: 0.2em;
    color: var(--muted);
  }
  .qa {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .qa li {
    position: relative;
    padding: 1.7rem 1.6rem 1.8rem;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    transition: border-color 0.25s, transform 0.4s var(--ease);
  }
  .qa li:hover {
    border-color: color-mix(in srgb, var(--blue) 45%, var(--line));
    transform: translateY(-3px);
  }
  .ico {
    width: 3.2rem;
    height: 3.2rem;
    stroke-width: 2;
  }
  .rail {
    stroke: var(--muted);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .rail.b {
    stroke: var(--ring);
  }
  .ico circle {
    fill: var(--bg-2);
    stroke: var(--ring);
  }
  .ico .hot {
    stroke: var(--blue);
  }
  .ico circle.hot {
    fill: var(--blue);
  }
  .ico .fill {
    fill: var(--blue);
    stroke: var(--blue);
    stroke-linejoin: round;
  }
  .q {
    margin-top: 1.5rem;
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  h3 {
    margin-top: 0.5rem;
    font-size: 1.4rem;
  }
  .d {
    margin-top: 0.7rem;
    color: var(--muted);
    font-size: 0.97rem;
  }
  @media (max-width: 860px) {
    .qa {
      grid-template-columns: 1fr;
    }
  }
</style>
