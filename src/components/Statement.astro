---
// each answer is shown as the real thing, in the app's own panels, joined by one rule.
import Card from './ui/Card.astro';
import Commits from './ui/Commits.astro';
import Folders from './ui/Folders.astro';
import Executions from './ui/Executions.astro';

const plates = [
  { q: 'Which version ran?', a: 'A commit.', d: 'Pipelines live in Git. Commits never change, and every run names the exact one that produced it.' },
  { q: 'What could it touch?', a: 'Only what it was granted.', d: 'Access is per agent and per folder, read-only. Nothing outside the granted folders is in range.' },
  { q: 'What happened?', a: 'A record of every run.', d: 'Logs, exit code and generated files are kept and tied to the version that ran.' },
];
---

<section class="statement" data-live>
  <div class="wrap">
    <h2 class="head">
      <span class="lede">Agents are easy to build.</span>
      <span class="lede dim">Knowing what they did is the hard part.</span>
    </h2>

    <div class="plates">
      <div class="rule" aria-hidden="true">
        <i></i><i></i><i></i>
        <b></b>
      </div>
      {
        plates.map((p, n) => (
          <article class="plate">
            <header>
              <span class="hex mono">{n + 1}</span>
              <span class="q mono">{p.q}</span>
            </header>
            <div class="screen" aria-hidden="true">
              {n === 0 && (
                <Card title="Commit ancestry" tag="immutable">
                  <Commits commits={[{ hash: '7f3a2c1', msg: 'Tighten the classifier', tag: 'main', current: true }, { hash: '3eb4dd8', msg: 'Scope folder access to Finance' }, { hash: '9d20b6e', msg: 'Initial pipeline' }]} />
                </Card>
              )}
              {n === 1 && (
                <Card title="Folder access" tag="read-only">
                  <Folders granted={['Finance']} />
                </Card>
              )}
              {n === 2 && (
                <Card title="Executions" tag="record">
                  <Executions rows={[{ agent: 'Invoice reconciler', hash: '7f3a2c1', state: 'succeeded', note: '4 steps · all passed' }, { agent: 'Support triage', hash: '3eb4dd8', state: 'failed', note: 'failed at 03 Validate' }, { agent: 'Access review', hash: '9d20b6e', state: 'succeeded' }]} />
                </Card>
              )}
            </div>
            <h3>{p.a}</h3>
            <p>{p.d}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .statement {
    padding-block: clamp(4rem, 9vw, 7rem);
    font-size: 0.8rem;
  }
  .head {
    max-width: 52rem;
  }
  .lede {
    display: block;
    font-size: clamp(1.8rem, 4.4vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
    font-weight: 600;
  }
  .dim {
    color: var(--muted);
  }
  .plates {
    position: relative;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.4vw, 2rem);
  }
  /* the rule that joins the three plates */
  .rule {
    position: absolute;
    left: 0;
    right: 0;
    top: 0.95rem;
    height: 1px;
    background: var(--line);
  }
  .rule b {
    position: absolute;
    inset: 0 auto 0 0;
    width: 100%;
    background: linear-gradient(90deg, var(--blue) 0 20%, transparent 20% 100%) 0 0 / 200% 100%;
    animation: statement-run 6s linear infinite;
    animation-play-state: paused;
  }
  .statement.is-live .rule b {
    animation-play-state: running;
  }
  @keyframes statement-run {
    to {
      background-position: -200% 0;
    }
  }
  .plate {
    position: relative;
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  header {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    position: relative;
    z-index: 1;
  }
  .hex {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2.3rem;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.8rem;
    font-weight: 600;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
  }
  .q {
    padding: 0.2rem 0.6rem;
    background: var(--bg);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .screen {
    padding-top: 0.4rem;
    transition: transform 0.5s var(--ease);
  }
  .plate:hover .screen {
    transform: translateY(-4px);
  }
  h3 {
    font-size: clamp(1.5rem, 2.4vw, 2.1rem);
    letter-spacing: -0.04em;
    line-height: 1.1;
  }
  .plate > p {
    color: var(--muted);
    font-size: 1rem;
  }
  @media (max-width: 900px) {
    .plates {
      grid-template-columns: 1fr;
      gap: 2.6rem;
    }
    .rule {
      display: none;
    }
  }
</style>
