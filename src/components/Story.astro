---
// the same three questions asked of an agent that runs loose and of one that runs in Reinyard.
// Left, the answers are guesses. Right, they resolve one by one into something you can point at.
const rows = [
  { q: 'Which version ran?', loose: 'Whatever was on the machine at the time', yes: 'Commit 7f3a2c1, unchanged since' },
  { q: 'What could it reach?', loose: 'Anything the account could', yes: 'The Finance folder, read-only' },
  { q: 'What did it do?', loose: 'Scattered logs, if they were kept', yes: 'A run record: logs, exit code, files' },
];
---

<section id="how" class="story" data-live>
  <div class="wrap">
    <header class="head">
      <span class="label">How it works</span>
      <h2 class="h2">The same agent, with and without a rein.</h2>
      <p class="lead">Ask three questions about a run. Without Reinyard they are guesses; with it, each one has an answer you can open.</p>
    </header>

    <div class="cols">
      <div class="col loose">
        <p class="tag mono"><i></i>Without Reinyard</p>
        <ul>
          {rows.map((r) => <li><span class="q">{r.q}</span><b>{r.loose}</b><em class="mono" aria-hidden="true">?</em></li>)}
        </ul>
      </div>
      <div class="col held brk">
        <p class="tag mono"><i></i>With Reinyard</p>
        <ul>
          {
            rows.map((r, n) => (
              <li style={`--n:${n}`}>
                <span class="q">{r.q}</span>
                <b>{r.yes}</b>
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" /></svg>
              </li>
            ))
          }
        </ul>
        <p class="steps mono"><span>Define</span><i></i><span>Isolate</span><i></i><span>Record</span></p>
      </div>
    </div>
  </div>
</section>

<style>
  .story {
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .head {
    display: grid;
    gap: 0.9rem;
    max-width: 46rem;
  }
  .cols {
    margin-top: clamp(2.4rem, 5vw, 3.8rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2.4rem);
  }
  .col {
    padding: clamp(1.3rem, 3vw, 2.2rem);
    border-radius: var(--r-lg);
    display: grid;
    gap: 1.2rem;
    align-content: start;
  }
  .loose {
    border: 1px dashed var(--line);
    color: var(--muted);
  }
  .held {
    --bl: 18px;
    background: var(--bg-2);
    border: 1px solid var(--line);
  }
  .tag {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .tag i {
    width: 0.55rem;
    height: 0.62rem;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: var(--muted);
    opacity: 0.6;
  }
  .held .tag {
    color: var(--blue-text);
  }
  .held .tag i {
    background: var(--blue);
    opacity: 1;
  }
  ul {
    display: grid;
  }
  li {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.2rem 1rem;
    align-items: center;
    padding: 1.05rem 0;
    border-top: 1px solid var(--line);
  }
  .q {
    grid-column: 1 / -1;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  li b {
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    letter-spacing: -0.02em;
    font-weight: 500;
  }
  .loose b {
    font-style: italic;
    opacity: 0.75;
  }
  .loose em {
    font-style: normal;
    font-size: 1.5rem;
    color: var(--muted);
    opacity: 0.6;
  }
  .held b {
    color: var(--ink);
    font-weight: 600;
  }
  .held svg {
    width: 1.4rem;
    height: 1.4rem;
    fill: none;
    stroke: var(--blue);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 16;
  }
  .steps {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .steps i {
    flex: 1;
    height: 0;
    border-top: 1px dashed var(--line);
  }
  .story.is-live .held li {
    animation: story-in 0.7s var(--ease) calc(0.4s + var(--n) * 0.55s) both;
  }
  .story.is-live .held svg path {
    animation: story-draw 0.5s var(--ease) calc(0.8s + var(--n) * 0.55s) both;
  }
  .story.is-live .loose em {
    animation: story-blink 3.2s ease-in-out infinite;
  }
  @keyframes story-in {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }
  @keyframes story-draw {
    from {
      stroke-dashoffset: 16;
    }
  }
  @keyframes story-blink {
    50% {
      opacity: 0.2;
    }
  }
  @media (max-width: 860px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
