---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import Product from '../components/Product.astro';
import Story from '../components/Story.astro';
import Deploy from '../components/Deploy.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
---

<Base
  title="Reinyard: a controlled place for agents to work"
  description="Build, version and run agents and automations in isolated sandboxes. Every change lives in Git and every run is on record. Self-hosted, managed cloud coming soon."
  path="/"
>
  <Hero />
  <Statement />
  <Product />
  <Story />
  <Deploy />
  <Pricing />
  <Faq />
  <CtaBand />
</Base>
