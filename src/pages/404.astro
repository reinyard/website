---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · Reinyard" description="This page doesn’t exist." path="/404/" noindex>
  <section class="nf wrap">
    <p class="code mono">404</p>
    <h1>This one got out of the yard.</h1>
    <p class="muted">The page you’re looking for doesn’t exist or has moved.</p>
    <a class="btn primary" href="/">Back to home</a>
  </section>
</Base>

<style>
  .nf {
    min-height: 62vh;
    display: grid;
    place-content: center;
    justify-items: start;
    gap: 1.25rem;
    padding-block: 6rem;
  }
  .code {
    color: var(--blue-text);
    letter-spacing: 0.1em;
  }
  h1 {
    font-size: clamp(2rem, 6vw, 4.4rem);
    letter-spacing: -0.055em;
    max-width: 14ch;
  }
</style>
