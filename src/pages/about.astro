---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';

const principles = [
  { t: 'Autonomy needs a record', d: 'If an agent can act, someone must be able to see what it did, when, and under which version.' },
  { t: 'Least access by default', d: 'An agent should reach only the data it has been granted. Everything else stays out of range.' },
  { t: 'Change belongs in Git', d: 'Agents evolve. Commits, branches and merges are the proven way to review and undo change.' },
  { t: 'Run it where your data lives', d: 'You should be able to host it yourself, on infrastructure you control. A managed cloud is a choice, not a requirement.' },
];

// Founders. Bios use only expertise and education; no employers or contact details.
//
// Both portraits are framed to the same camera distance. Each photo records where the pupils are, in pixels of the 900 x 900
// source (left pupil, right pupil). `fit()` scales and places the image so every face gets the same pupil distance (FRAME.ipd,
// as a share of the frame width) and the same eye line (FRAME.eyeY, as a share of the frame height). If a photo is replaced,
// re-measure its two pupils and update `eyes`; nothing else needs to change. Keep the frame at 4:5 (FRAME.ratio = 1.25).
const SRC = 900;
const FRAME = { ipd: 0.225, eyeY: 0.385, ratio: 1.25 };
const fit = ([l, r]: [number[], number[]]) => {
  const ipd = Math.hypot(r[0] - l[0], r[1] - l[1]);
  const w = ((FRAME.ipd * SRC) / ipd) * 100; // image width, % of the frame width
  const mx = (l[0] + r[0]) / 2;
  const my = (l[1] + r[1]) / 2;
  const left = 50 - (mx / SRC) * w;
  const top = FRAME.eyeY * 100 - (my / SRC) * (w / FRAME.ratio);
  return `--w:${w.toFixed(2)}%;--l:${left.toFixed(2)}%;--t:${top.toFixed(2)}%`;
};
const founders = [
  {
    name: 'Noa Yu Ventura',
    role: 'Co-founder, Chief Executive Officer',
    photo: '/team/noa.webp',
    eyes: [[361, 282.5], [471, 269]] as [number[], number[]],
    bio: 'Security and platform engineer specializing in LLM gateways, MCP and secure systems, where agents meet real infrastructure. Trained in Informatics Engineering at UPC.',
  },
  {
    name: 'Albert Bausili',
    role: 'Co-founder, Chief Technology Officer',
    photo: '/team/albert.webp',
    eyes: [[340, 355], [498.5, 342.5]] as [number[], number[]],
    bio: 'Senior AI engineer with a backend and systems background, from kernel I/O to LLM agents. Master’s at UPC’s Barcelona School of Informatics, and creator of Celeris, a Go HTTP engine.',
  },
];

// The hexagon field behind the hero: the same lattice as the home page (pointy-top cells, radius 32, 22 on phones, 1px lines),
// drawn as a tiling mask so it costs no script.
const hexMask = (R: number) => {
  const w = Math.sqrt(3) * R;
  const h = 3 * R;
  const f = (n: number) => +n.toFixed(3);
  const d = `M${f(w / 2)} 0L${f(w)} ${f(R / 2)}V${f(1.5 * R)}L${f(w / 2)} ${2 * R}L0 ${f(1.5 * R)}V${f(R / 2)}ZM${f(w / 2)} ${2 * R}V${h}`;
  const svg = `<svg xmlns='http://www.w3.org/2000/svg' width='${f(w)}' height='${h}' viewBox='0 0 ${f(w)} ${h}'><path d='${d}' fill='none' stroke='#000' stroke-width='1'/></svg>`;
  return { url: `url("data:image/svg+xml,${encodeURIComponent(svg)}")`, size: `${f(w)}px ${h}px` };
};
const hexLg = hexMask(32);
const hexSm = hexMask(22);
---

<Base
  overlay
  title="About · Reinyard"
  description="Reinyard is a controlled place for agents to work: a rein to guide and restrain, and a yard to work in. Meet the founders."
  path="/about/"
>
  <section class="hero" style={`--hex-lg:${hexLg.url};--hex-lg-size:${hexLg.size};--hex-sm:${hexSm.url};--hex-sm-size:${hexSm.size}`}>
    <div class="field" aria-hidden="true"></div>
    <div class="wrap">
      <span class="label">About</span>
      <h1>
        Agents are powerful.
        <span class="line2">Power needs a <span class="rein brk">rein.</span></span>
      </h1>
      <p class="lead">
        Reinyard exists so a company can build, version and run agents and automations without losing sight of what
        they did.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap why">
      <div class="reveal">
        <span class="label">Why we’re building it</span>
        <h2 class="h2">Building an agent is the easy part.</h2>
      </div>
      <div class="prose reveal">
        <p>
          Teams are starting to hand real work to agents: reading files, reconciling numbers, answering requests. The
          tools to build one are everywhere.
        </p>
        <p>
          The questions that matter once it is running are harder. <b>Which version ran? What could it touch? What
          happened?</b> We are building Reinyard so every one of those has a plain answer.
        </p>
      </div>
    </div>
  </section>

  <section class="section name">
    <div class="wrap pair">
      <div class="reveal">
        <span class="label">The name</span>
        <h2 class="h2">A rein to guide.<br />A yard to work in.</h2>
        <div class="words">
          <p>
            <b>Rein</b> is the control: scoped access, isolation, a record of every run. It guides an agent and holds
            it back when it needs holding.
          </p>
          <p>
            <b>Yard</b> is the place: a bounded space where agents do real work, with room to move inside it and a
            clear edge around it.
          </p>
        </div>
      </div>

      <figure class="logo-fig reveal" aria-label="The Reinyard mark: a hexagon, the agent, held inside six brackets, the yard, with a line, the rein, running out through the gate">
        <svg viewBox="40 128 900 768" fill="none" aria-hidden="true">
          <g class="yard" stroke-width="40" stroke-linecap="round" stroke-linejoin="round">
            <path d="M297 298 221 342V430" /><path d="M727 298 803 342V430" />
            <path d="M221 594V682L297 726" /><path d="M803 594V682L727 726" />
            <path d="M435 220 512 176 589 220" /><path d="M435 804 512 848 589 804" />
          </g>
          <path class="rein-line" d="M402 512H70" stroke-width="12" stroke-linecap="round" />
          <path class="core" d="M512 400.1 608.9 456.1V568L512 623.9 415.1 568V456.1Z" stroke-width="28" stroke-linejoin="round" />
          <g class="tag"><text x="64" y="470">REIN</text></g>
          <g class="tag"><text x="858" y="398">YARD</text><path d="M820 386H846" stroke-width="3" stroke-linecap="round" /></g>
          <g class="tag mid"><text x="512" y="712">AGENT</text></g>
        </svg>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="reveal">
        <span class="label">What we believe</span>
        <h2 class="h2">Four ideas behind the product.</h2>
      </div>
      <ol class="principles">
        {
          principles.map((b, i) => (
            <li class="reveal">
              <span class="n mono">0{i + 1}</span>
              <h3>{b.t}</h3>
              <p>{b.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section team" id="team">
    <div class="wrap">
      <div class="reveal">
        <span class="label">Founders</span>
        <h2 class="h2">The people behind it.</h2>
      </div>
      <ul class="founders">
        {
          founders.map((f) => (
            <li class="founder reveal">
              <div class="portrait brk" style={fit(f.eyes)}>
                <img src={f.photo} width={SRC} height={SRC} alt={`Portrait of ${f.name}`} loading="lazy" decoding="async" />
              </div>
              <div class="who">
                <h3>{f.name}</h3>
                <p class="role">{f.role}</p>
                <p class="bio">{f.bio}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="hello reveal">
        <span>Questions, ideas, or want to know when the managed cloud opens?</span>
        <a href="mailto:contact@reinyard.com">contact@reinyard.com</a>
        <a href="https://github.com/reinyard" rel="noopener">github.com/reinyard</a>
      </p>
    </div>
  </section>

  <section class="section where">
    <div class="wrap pair">
      <div class="reveal">
        <span class="label">Where we are</span>
        <h2 class="h2">Early, and moving.</h2>
      </div>
      <div class="prose reveal">
        <p>
          Reinyard is under active development. It is built to run on-premises, and a managed cloud is planned for teams who
          would rather not run it themselves. Enterprise will also be offered as SaaS, on-premises or hybrid.
        </p>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  const fig = document.querySelector('.logo-fig');
  if (fig) new IntersectionObserver(([e]) => fig.classList.toggle('live', e.isIntersecting)).observe(fig);
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    /* the page starts under the floating header, so the hexagon field runs right up to the top edge */
    padding-block: calc(4.25rem + clamp(3.5rem, 9vw, 7rem)) clamp(2rem, 5vw, 3rem);
    border-bottom: 1px solid var(--line);
  }
  .field {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--cell);
    /* a little lighter than on the home page: small text (the label, the lead) sits right on top of it */
    opacity: 0.7;
    -webkit-mask-image: var(--hex-lg);
    mask-image: var(--hex-lg);
    -webkit-mask-size: var(--hex-lg-size);
    mask-size: var(--hex-lg-size);
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    /* fades the field out towards the section below, so it never ends on a hard edge */
    background: linear-gradient(to bottom, transparent 40%, var(--bg) 100%);
    pointer-events: none;
  }
  .hero .label {
    /* the label is small text on the hexagon field: a shade stronger than the usual accent keeps it above 4.5:1 on a pattern line */
    color: color-mix(in srgb, var(--blue-text) 82%, var(--ink));
  }
  h1 {
    margin-top: 1.4rem;
    font-size: clamp(2.3rem, 6.6vw, 5.2rem);
    line-height: 1.04;
    letter-spacing: -0.05em;
    font-weight: 600;
    max-width: 16ch;
  }
  .line2 {
    display: block;
    color: var(--muted);
  }
  .rein {
    --bl: 0.2em;
    --bw: 0.05em;
    --bc: var(--blue);
    color: var(--blue);
    display: inline-block;
    padding: 0.02em 0.16em 0.08em 0.12em;
    margin-left: -0.08em;
  }
  .lead {
    margin-top: 1.8rem;
  }

  .why,
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .prose {
    display: grid;
    gap: 1.2rem;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    padding-top: 2.2rem;
  }
  .prose b,
  .words b {
    color: var(--ink);
    font-weight: 600;
  }
  .prose a {
    color: var(--blue-text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* the name, drawn */
  .words {
    margin-top: 1.6rem;
    display: grid;
    gap: 1rem;
    color: var(--muted);
    max-width: 30rem;
  }
  .logo-fig {
    margin: 0;
    justify-self: center;
    width: min(100%, 30rem);
  }
  .logo-fig svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .yard {
    stroke: var(--ring);
  }
  .core {
    fill: var(--core);
    stroke: var(--core);
  }
  .rein-line {
    stroke: var(--blue);
    stroke-dasharray: 2 26;
  }
  .logo-fig.live .rein-line {
    animation: lead 2.4s linear infinite;
  }
  @keyframes lead {
    to {
      stroke-dashoffset: -56;
    }
  }
  .tag text {
    font-family: var(--mono);
    font-size: 30px;
    font-weight: 500;
    letter-spacing: 0.14em;
    fill: var(--muted);
  }
  .tag.mid text {
    text-anchor: middle;
  }
  .tag path {
    stroke: var(--muted);
  }

  .principles {
    margin-top: clamp(2.2rem, 5vw, 3.5rem);
    border-top: 1px solid var(--line);
  }
  .principles li {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 0.4rem clamp(1rem, 4vw, 3rem);
    align-items: baseline;
    padding-block: clamp(1.3rem, 2.6vw, 1.9rem);
    border-bottom: 1px solid var(--line);
  }
  .n {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--r);
    background: var(--a-2);
    color: var(--blue-text);
    font-size: 0.78rem;
    align-self: start;
  }
  .principles h3 {
    font-size: clamp(1.25rem, 2.2vw, 1.7rem);
    letter-spacing: -0.035em;
    line-height: 1.15;
  }
  .principles p {
    color: var(--muted);
    font-size: clamp(1rem, 1.3vw, 1.1rem);
    max-width: 34rem;
  }

  /* founders: two portraits at the same camera distance, 13rem wide (about 208 x 260 px), each beside its text */
  .founders {
    --pw: 13rem;
    margin-top: clamp(2.2rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }
  .founder {
    display: grid;
    grid-template-columns: var(--pw) minmax(0, 1fr);
    gap: clamp(1.1rem, 2.4vw, 1.8rem);
    align-items: start;
    padding-top: 1.6rem;
    border-top: 1px solid var(--line);
  }
  /* The frame is always 4:5. The photo inside is sized and placed from the measured pupils (see `fit()` above), so the
     image must not be fitted or cropped by anything else. */
  .portrait {
    --bl: 18px;
    --bc: var(--blue);
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--bg-3);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .portrait img {
    position: absolute;
    display: block;
    max-width: none;
    height: auto;
    width: var(--w);
    left: var(--l);
    top: var(--t);
  }
  .portrait::before {
    z-index: 1;
    inset: 8px;
  }
  .who h3 {
    font-size: clamp(1.3rem, 2.2vw, 1.6rem);
    letter-spacing: -0.035em;
  }
  .role {
    margin-top: 0.35rem;
    color: var(--ink-2);
    font-size: 0.98rem;
  }
  .bio {
    margin-top: 0.9rem;
    color: var(--muted);
    font-size: 1rem;
    max-width: 26rem;
  }
  .hello {
    margin-top: clamp(1.8rem, 4vw, 2.8rem);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1.6rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
  .hello a {
    color: var(--blue-text);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 1000px) {
    .founders {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
  @media (max-width: 820px) {
    .why,
    .pair {
      grid-template-columns: 1fr;
    }
    .prose {
      padding-top: 0;
    }
    .principles li {
      grid-template-columns: 2.6rem minmax(0, 1fr);
    }
    .principles p {
      grid-column: 2;
    }
  }
  @media (max-width: 640px) {
    .field {
      -webkit-mask-image: var(--hex-sm);
      mask-image: var(--hex-sm);
      -webkit-mask-size: var(--hex-sm-size);
      mask-size: var(--hex-sm-size);
    }
  }
  @media (max-width: 520px) {
    .founders {
      --pw: 11rem;
    }
    .founder {
      grid-template-columns: 1fr;
    }
    .portrait {
      width: var(--pw);
    }
  }
</style>
