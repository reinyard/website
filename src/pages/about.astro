---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';

const principles = [
  { t: 'Autonomy needs a record', d: 'If an agent can act, someone must be able to see what it did, when, and under which version.' },
  { t: 'Least access by default', d: 'An agent should reach only the data it has been granted. Everything else stays out of range.' },
  { t: 'Change belongs in Git', d: 'Agents evolve. Commits, branches and merges are the proven way to review and undo change.' },
  { t: 'Run it where your data lives', d: 'You should be able to host it yourself, on infrastructure you control. A managed cloud is a choice, not a requirement.' },
];

// Founders. Bios use only expertise and education; no employers or contact details.
const founders = [
  {
    name: 'Noa Yu Ventura',
    role: 'Chief Executive Officer',
    title: 'Co-founder',
    photo: '/team/noa.webp',
    bio: 'Security and platform engineer focused on LLM gateways, MCP and secure systems. Studied Informatics Engineering at UPC.',
  },
  {
    name: 'Albert Bausili',
    role: 'Chief Technology Officer',
    title: 'Co-founder',
    photo: '/team/albert.webp',
    bio: 'Backend and systems engineer, from kernel I/O to LLM agents. Master’s at UPC’s Barcelona School of Informatics, and creator of Celeris, a Go HTTP engine.',
  },
];
---

<Base
  title="About · Reinyard"
  description="Reinyard is a controlled place for agents to work: a rein to guide and restrain, and a yard to work in. Meet the founders."
  path="/about/"
>
  <section class="hero">
    <div class="wrap">
      <span class="label">About</span>
      <h1>
        Agents are powerful.
        <span class="line2">Power needs a <span class="rein brk">rein.</span></span>
      </h1>
      <p class="lead">
        Reinyard exists so a company can build, version and run agents and automations without losing sight of what
        they did.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap why">
      <div class="reveal">
        <span class="label">Why we’re building it</span>
        <h2 class="h2">Building an agent is the easy part.</h2>
      </div>
      <div class="prose reveal">
        <p>
          Teams are starting to hand real work to agents: reading files, reconciling numbers, answering requests. The
          tools to build one are everywhere.
        </p>
        <p>
          The questions that matter once it is running are harder. <b>Which version ran? What could it touch? What
          happened?</b> We are building Reinyard so every one of those has a plain answer.
        </p>
      </div>
    </div>
  </section>

  <section class="section name">
    <div class="wrap pair">
      <div class="reveal">
        <span class="label">The name</span>
        <h2 class="h2">A rein to guide.<br />A yard to work in.</h2>
        <div class="words">
          <p>
            <b>Rein</b> is the control: scoped access, isolation, a record of every run. It guides an agent and holds
            it back when it needs holding.
          </p>
          <p>
            <b>Yard</b> is the place: a bounded space where agents do real work, with room to move inside it and a
            clear edge around it.
          </p>
        </div>
      </div>

      <figure class="logo-fig reveal" aria-label="The Reinyard mark: a hexagon, the agent, held inside six brackets, the yard, with a line, the rein, running out through the gate">
        <svg viewBox="40 128 900 768" fill="none" aria-hidden="true">
          <g class="yard" stroke-width="40" stroke-linecap="round" stroke-linejoin="round">
            <path d="M297 298 221 342V430" /><path d="M727 298 803 342V430" />
            <path d="M221 594V682L297 726" /><path d="M803 594V682L727 726" />
            <path d="M435 220 512 176 589 220" /><path d="M435 804 512 848 589 804" />
          </g>
          <path class="rein-line" d="M402 512H70" stroke-width="12" stroke-linecap="round" />
          <path class="core" d="M512 400.1 608.9 456.1V568L512 623.9 415.1 568V456.1Z" stroke-width="28" stroke-linejoin="round" />
          <g class="tag"><text x="64" y="470">REIN</text></g>
          <g class="tag"><text x="826" y="178">YARD</text><path d="M806 190 790 214" stroke-width="3" /></g>
          <g class="tag mid"><text x="512" y="712">AGENT</text></g>
        </svg>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="reveal">
        <span class="label">What we believe</span>
        <h2 class="h2">Four ideas behind the product.</h2>
      </div>
      <ul class="principles">
        {
          principles.map((b, i) => (
            <li class="reveal">
              <span class="n mono">0{i + 1}</span>
              <h3>{b.t}</h3>
              <p>{b.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section team" id="team">
    <div class="wrap">
      <div class="reveal">
        <span class="label">Founders</span>
        <h2 class="h2">The people behind it.</h2>
      </div>
      <ul class="founders">
        {
          founders.map((f) => (
            <li class="founder reveal">
              <div class="portrait brk">
                <img src={f.photo} width="900" height="900" alt={`Portrait of ${f.name}`} loading="lazy" decoding="async" />
              </div>
              <div class="who">
                <h3>{f.name}</h3>
                <p class="role">{f.role}</p>
                <p class="badge">{f.title}</p>
                <p class="bio">{f.bio}</p>
              </div>
            </li>
          ))
        }
        <li class="hello reveal">
          <span class="label">Say hello</span>
          <div>
            <h3>Questions, ideas, or want to know when the managed cloud opens?</h3>
            <p class="links">
              <a href="mailto:contact@reinyard.com">contact@reinyard.com</a>
              <a href="https://github.com/reinyard" rel="noopener">github.com/reinyard</a>
            </p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="section where">
    <div class="wrap pair">
      <div class="reveal">
        <span class="label">Where we are</span>
        <h2 class="h2">Early, and moving.</h2>
      </div>
      <div class="prose reveal">
        <p>
          Reinyard is under active development. It is built to run on-premises, and a managed cloud is planned for teams who
          would rather not run it themselves. Enterprise will also be offered as SaaS, on-premises or hybrid.
        </p>
        <p>
          Follow along on <a href="https://github.com/reinyard" rel="noopener">GitHub</a> or write to us at{' '}
          <a href="mailto:contact@reinyard.com">contact@reinyard.com</a>.
        </p>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  const fig = document.querySelector('.logo-fig');
  if (fig) new IntersectionObserver(([e]) => fig.classList.toggle('live', e.isIntersecting)).observe(fig);
</script>

<style>
  .hero {
    padding-block: clamp(4rem, 10vw, 8rem) clamp(2rem, 5vw, 3rem);
    border-bottom: 1px solid var(--line);
  }
  h1 {
    margin-top: 1.4rem;
    font-size: clamp(2.3rem, 6.6vw, 5.2rem);
    line-height: 1.04;
    letter-spacing: -0.05em;
    font-weight: 600;
    max-width: 16ch;
  }
  .line2 {
    display: block;
    color: var(--muted);
  }
  .rein {
    --bl: 0.2em;
    --bw: 0.05em;
    --bc: var(--blue);
    color: var(--blue);
    display: inline-block;
    padding: 0.02em 0.16em 0.08em 0.12em;
    margin-left: -0.08em;
  }
  .lead {
    margin-top: 1.8rem;
  }

  .why,
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .prose {
    display: grid;
    gap: 1.2rem;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    padding-top: 2.2rem;
  }
  .prose b,
  .words b {
    color: var(--ink);
    font-weight: 600;
  }
  .prose a {
    color: var(--blue-text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* the name, drawn */
  .words {
    margin-top: 1.6rem;
    display: grid;
    gap: 1rem;
    color: var(--muted);
    max-width: 30rem;
  }
  .logo-fig {
    margin: 0;
    justify-self: center;
    width: min(100%, 30rem);
  }
  .logo-fig svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .yard {
    stroke: var(--ring);
  }
  .core {
    fill: var(--core);
    stroke: var(--core);
  }
  .rein-line {
    stroke: var(--blue);
    stroke-dasharray: 2 26;
  }
  .logo-fig.live .rein-line {
    animation: lead 2.4s linear infinite;
  }
  @keyframes lead {
    to {
      stroke-dashoffset: -56;
    }
  }
  .tag text {
    font-family: var(--mono);
    font-size: 30px;
    font-weight: 500;
    letter-spacing: 0.14em;
    fill: var(--muted);
  }
  .tag.mid text {
    text-anchor: middle;
  }
  .tag path {
    stroke: var(--muted);
  }

  .principles {
    margin-top: clamp(2.2rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .principles li {
    padding: 1.6rem;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    transition: border-color 0.25s, transform 0.35s var(--ease);
  }
  .principles li:hover {
    border-color: color-mix(in srgb, var(--blue) 45%, var(--line));
    transform: translateY(-3px);
  }
  .n {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--r);
    background: var(--a-2);
    color: var(--blue-text);
    font-size: 0.78rem;
  }
  .principles h3 {
    margin-top: 1.6rem;
    font-size: 1.1rem;
  }
  .principles p {
    margin-top: 0.6rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  /* founders */
  .founders {
    margin-top: clamp(2.2rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
  }
  .hello {
    aspect-ratio: 5 / 6;
    display: grid;
    align-content: space-between;
    padding: 1.6rem;
    border: 1.5px dashed var(--line);
    border-radius: var(--r-lg);
  }
  .hello h3 {
    font-size: 1.25rem;
    line-height: 1.25;
  }
  .hello .links {
    margin-top: 1.2rem;
    display: grid;
    gap: 0.4rem;
  }
  .hello a {
    color: var(--blue-text);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .portrait {
    --bl: 22px;
    --bc: var(--blue);
    aspect-ratio: 5 / 6;
    background: var(--bg-3);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
  }
  .portrait::before {
    z-index: 1;
    inset: 10px;
  }
  .who {
    margin-top: 1.1rem;
  }
  .who h3 {
    font-size: 1.35rem;
  }
  .role {
    margin-top: 0.3rem;
    color: var(--ink-2);
  }
  .badge {
    margin-top: 0.7rem;
  }
  .bio {
    margin-top: 0.9rem;
    color: var(--muted);
    font-size: 0.97rem;
    max-width: 24rem;
  }

  @media (max-width: 1000px) {
    .principles {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 820px) {
    .why,
    .pair {
      grid-template-columns: 1fr;
    }
    .prose {
      padding-top: 0;
    }
    .founders {
      grid-template-columns: 1fr 1fr;
    }
    .hello {
      aspect-ratio: auto;
      gap: 1.5rem;
    }
  }
  @media (max-width: 560px) {
    .principles,
    .founders {
      grid-template-columns: 1fr;
    }
  }
</style>
